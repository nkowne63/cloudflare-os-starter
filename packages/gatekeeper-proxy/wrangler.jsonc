{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gatekeeper-proxy",
  "main": ".wrangler/validate/src/index.ts",
  "build": {
    "command": "pnpm exec capnweb-validate build --out .wrangler/validate",
    "watch_dir": "src"
  },
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["allow_irrevocable_stub_storage", "nodejs_compat", "global_fetch_strictly_public"],
  "migrations": [{ "tag": "v0", "new_sqlite_classes": ["ProxyGatekeeper"] }],
  "vars": {
    "PROXY_SERVICES": "{\"esm\":{\"upstream\":\"https://esm.sh\",\"via\":\"public\",\"writeMethods\":\"deny\"}}"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
